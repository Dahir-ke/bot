MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server

# When true, the bot container execs final_bot.py directly as its own PID 1
# (see docker-compose.yml) so Docker's restart:unless-stopped actually
# supervises the trading loop - a crash or unexpected SIGTERM brings it
# back automatically. Leave unset/false on a fresh deploy until you've
# deliberately verified everything and want trading to start.
BOT_AUTOSTART=false

# Dashboard login (bot.tatuatechnology.com) - generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SECRET_KEY=replace-with-a-generated-random-value
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-strong-password
