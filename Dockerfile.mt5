# Runs the actual Exness MT5 terminal under Wine (MT5 has no Linux build)
# plus a Wine-hosted Windows Python running mt5_server.py, a small
# classic-RPyC server we own end to end, exposing the real MetaTrader5
# PyPI package on :18812 for the bot. Not mt5linux's prebuilt
# mt5server.exe (a third-party PyInstaller binary of unclear build
# date/provenance, never confirmed to actually work here across four
# different Wine configurations including MetaQuotes' own official
# recipe) - installing genuine Windows Python + `pip install
# MetaTrader5` isolates whether that specific binary was the broken
# piece, separate from Wine/terminal config. Headless - Xvfb provides
# the virtual display Windows GUI apps need; x11vnc is only for
# optional debugging, bound to 127.0.0.1 and reached via SSH tunnel,
# never exposed publicly. The terminal is left uninstalled-and-
# unlaunched here; mt5.initialize(login=,password=,server=) in the bot
# itself launches and logs it in on demand (see MQL5's own
# mt5.initialize() docs - it starts the terminal itself if one isn't
# already running, so there's no separate silent-login config file needed).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    WINEARCH=win64 \
    WINEPREFIX=/root/.wine \
    WINEDEBUG=-all \
    # Disables Wine's built-in Mono/Gecko installer prompts (.NET and
    # embedded-browser support neither MT5 nor mt5server.exe need) - left
    # enabled, the first wineboot in a headless container with no way to
    # click through a dialog hangs for minutes before failing outright.
    WINEDLLOVERRIDES="mscoree=;mshtml=" \
    XDG_RUNTIME_DIR=/tmp/xdg-runtime

RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y --no-install-recommends \
      wget gnupg2 ca-certificates \
      xvfb x11vnc icewm \
    && mkdir -pm755 /etc/apt/keyrings \
    && wget -O /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key \
    && wget -NP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/ubuntu/dists/noble/winehq-noble.sources \
    && apt-get update \
    # Three Wine versions (staging 9.22, stable 10.0, stable 11.0) all
    # reproduced the identical failure by hand - login handshake never
    # reaches the terminal ("MCP started on 127.0.0.1:22346" logs, then
    # nothing else, ever). Blind version-guessing was the wrong axis
    # entirely: MetaQuotes' own official Linux installer script
    # (download.terminal.free/cdn/web/metaquotes.software.corp/mt5/mt5linux.sh,
    # confirmed genuine - X-Service: MQL5 API response header, referenced
    # from metaquotes.net's own release notes) uses plain `winehq-staging`
    # (latest, unpinned - they don't pin either) and, critically, two
    # things we'd never done: `winecfg -v=win11` (every terminal log
    # we'd captured said "Windows 10 build 19043 on Wine..." - we were
    # never even emulating the Windows version MetaQuotes actually
    # configures) and installing the Microsoft Edge WebView2 Runtime
    # before MT5 itself. Matching their exact recipe now instead of
    # continuing to guess our own.
    && apt-get install -y --no-install-recommends --install-recommends winehq-staging \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

WORKDIR /opt/mt5

# Each RUN step below uses its own display number (:99, :98) rather than
# reusing one - a stale /tmp/.X99-lock left behind by an earlier,
# already-committed layer made a later Xvfb silently fail to bind, wine
# got no real display, and the installer exited 0 without installing
# anything (xvfb-run's own auto-allocated display made this worse, not
# better - it crashed outright partway through with "XIO: fatal IO error
# 2", diagnosed by hand and not worth carrying forward). Distinct
# per-step display numbers sidestep this class of bug entirely rather
# than depending on cleanup being perfect.
#
# Boots the Wine prefix once at build time (registry init, first-launch
# housekeeping) so container startup doesn't pay that cost on every restart.
# `winecfg -v=win11` matches MetaQuotes' own installer exactly - without
# it, Wine's default Windows-version emulation left every terminal log
# reporting "Windows 10 build 19043", not what MetaQuotes actually tests
# and configures.
RUN Xvfb :99 -screen 0 1024x768x16 & \
    sleep 3 && DISPLAY=:99 wineboot --init && DISPLAY=:99 winecfg -v=win11 && wineserver -w

# Microsoft Edge WebView2 Runtime - MetaQuotes' own installer puts this
# on every Linux/Wine setup before MT5 itself; same URL their script
# uses. /silent /install matches their exact invocation, no GUI dialog.
#
# `timeout 90` wraps the actual install - confirmed by hand that the
# bootstrapper's own MicrosoftEdgeUpdate.exe component can hang
# indefinitely under Wine (ran 10+ minutes with zero CPU/network
# activity, still not exited when killed - looks like it's stuck on
# its own update-server handshake, a known rough edge for Microsoft's
# auto-update services under Wine). The terminal fully rendered,
# streamed live data, and showed a login dialog in every earlier test
# today with NO WebView2 present at all, so it's not clearly required
# for the piece we actually care about - best-effort only, `; true`
# means a timeout or any other failure here doesn't block the rest of
# this build.
RUN wget -q https://msedge.sf.dl.delivery.mp.microsoft.com/filestreamingservice/files/f2910a1e-e5a6-4f17-b52d-7faf525d17f8/MicrosoftEdgeWebview2Setup.exe -O webview2.exe \
    && (Xvfb :97 -screen 0 1024x768x16 &) \
    && sleep 3 \
    && timeout 90 env DISPLAY=:97 wine webview2.exe /silent /install; true \
    && pkill -9 -f MicrosoftEdgeUpdate.exe; true \
    && sleep 3 && wineserver -k; true \
    && rm -f webview2.exe

# The broker-branded MT5 terminal - official MetaQuotes CDN, the same
# infrastructure every broker's build is served from (verified reachable
# and correctly typed before use here). /auto is MetaQuotes' own documented
# unattended-install flag. Installing it (not just downloading) registers
# it in the Wine registry so mt5.initialize() can auto-detect it later
# with no explicit path.
#
# mt5setup.exe is a ~5MB web-installer stub, not the full ~30MB+ terminal
# - it downloads the real thing itself during install. Confirmed by hand
# (see git history) that it reliably exits 1 under Wine/Xvfb even on a
# fully successful install (looks like a failed attempt to auto-launch
# the newly-installed terminal afterward, not an install failure) - `;
# true` stops that from aborting this RUN before the real check below
# ever runs; terminal64.exe actually existing is the only signal that
# matters.
RUN wget -q https://download.mql5.com/cdn/web/exness.technologies.ltd/mt5/exness5setup.exe -O mt5setup.exe \
    && (Xvfb :98 -screen 0 1024x768x16 &) \
    && sleep 3 \
    && DISPLAY=:98 wine mt5setup.exe /auto; true \
    && sleep 5 && wineserver -w \
    && rm mt5setup.exe \
    && found=$(find "$WINEPREFIX/drive_c" -iname "terminal64.exe" -print -quit) \
    && test -n "$found" \
    && echo "MT5 terminal installed OK at: $found"

# Genuine Windows Python under Wine, not a prebuilt binary. 3.12.7 -
# officially supported by both the current MetaTrader5 PyPI package
# and rpyc.
RUN wget -q https://www.python.org/ftp/python/3.12.7/python-3.12.7-amd64.exe -O python-installer.exe \
    && (Xvfb :96 -screen 0 1024x768x16 &) \
    && sleep 3 \
    && DISPLAY=:96 wine python-installer.exe /quiet InstallAllUsers=1 PrependPath=1 Include_test=0; true \
    && sleep 5 && wineserver -w \
    && rm python-installer.exe \
    && found=$(find "$WINEPREFIX/drive_c" -iname "python.exe" -print -quit) \
    && test -n "$found" \
    && echo "Wine Python installed OK at: $found"

# rpyc>=6.0.0,<7 - matches the pin already forced on the bot side (see
# requirements-linux.txt) for mt5linux==0.2.4's classic-RPyC client;
# both ends need the same major RPyC wire-protocol version.
RUN PYEXE=$(find "$WINEPREFIX/drive_c" -iname "python.exe" -path "*Python312*" -print -quit) \
    && (Xvfb :95 -screen 0 1024x768x16 &) \
    && sleep 3 \
    && DISPLAY=:95 wine "$PYEXE" -m pip install --no-cache-dir MetaTrader5 "rpyc>=6.0.0,<7" \
    && wineserver -w

COPY mt5_server.py /opt/mt5/mt5_server.py

COPY mt5-entrypoint.sh /opt/mt5/entrypoint.sh
RUN chmod +x /opt/mt5/entrypoint.sh

EXPOSE 18812 5900
CMD ["/opt/mt5/entrypoint.sh"]
